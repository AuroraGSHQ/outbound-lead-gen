# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (drafting outreach, classifying replies) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Lead sourcing (Apollo.io) ---
APOLLO_API_KEY=xxxx

# --- Gmail sending / inbox polling ---
# Run `python scripts/gmail_auth.py` once after placing your OAuth client
# secret at data/credentials.json (see docs/SETUP.md). That writes data/token.json.
GMAIL_SENDER_EMAIL=you@yourcompany.com
GMAIL_CREDENTIALS_PATH=data/credentials.json
GMAIL_TOKEN_PATH=data/token.json

# --- Twilio (Beacon's phone channel — SMS + outbound voice, optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- ElevenLabs (voice for Beacon's phone channel, optional) ---
# Only needed if you want Beacon to place voice calls; SMS works without it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOICE_CLIP_DIR=data/voice_clips
# Must be a real internet-reachable HTTPS URL (e.g. your Railway/Render
# domain) — Twilio fetches the synthesized voice clip from here to play it
# on the call. Leave blank until the app is deployed; voice calls will
# fail with a clear error until it's set.
PUBLIC_BASE_URL=

# --- Calendly (booking link + webhook) ---
CALENDLY_BOOKING_LINK=https://calendly.com/you/intro-call
CALENDLY_WEBHOOK_SIGNING_KEY=xxxx

# --- Business identity (used in email drafts) ---
BUSINESS_NAME=Your Company
BUSINESS_PITCH=We handle post-construction cleanup (rough clean, final clean, punch-list touch-up, debris/haul-away) so GCs and builders can hand over a spotless site on schedule without pulling their own crew off the next job.
BUSINESS_PHYSICAL_ADDRESS=123 Main St, Springfield, ST 00000
SENDER_NAME=Alyssa Young
SENDER_TITLE=Founder

# --- Owner / approvals ---
OWNER_EMAIL=alyoung1225@gmail.com
# Bootstrap owner account only — used once, on the very first run, to seed a
# real User row (role=owner) in the database. After that, log in and create
# every other teammate's account from the Users page; these two vars aren't
# read again once a user exists.
OWNER_UI_USERNAME=owner
OWNER_UI_PASSWORD=change-me

# --- Spectrum agent (optional) ---
# Without this, the scanner skips the review-count/recency check and still
# runs every other check (load speed, mobile, tracking, click-to-call).
GOOGLE_PLACES_API_KEY=

# --- Ads agent (optional, advanced) ---
# Leave both blank: the Orbit agent generates the full campaign brief
# (budget, audience, ad copy) for you to paste into each platform's ads
# manager by hand — the safe default until you've completed that platform's
# developer app review. See docs/SETUP.md before setting these.
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ACCESS_TOKEN=

# --- Prism (self-audit, optional) ---
# Aurora's own domain — Prism runs Spectrum's own passive checks against it.
# Blank = skipped.
OWN_DOMAIN=

# --- Behavior ---
# draft_and_approve (recommended, default): every outbound email queues for
# your approval before sending. autonomous: bot sends without review.
APPROVAL_MODE=draft_and_approve
# Cap on FIRST-TOUCH cold emails per day. This is not an arbitrary throttle —
# it's what keeps a brand-new sending pattern on your real Gmail address from
# getting flagged as spam, which would take down your *actual* email, not
# just this bot. See "Sizing your outreach volume" in docs/SETUP.md before
# raising this — ramp up over weeks, don't jump straight to a big number.
DAILY_OUTREACH_CAP=25
ICP_CONFIG_PATH=config/icp.yaml
DATABASE_URL=sqlite:///./data/leadgen.db

# --- Web app ---
APP_SECRET_KEY=change-me-to-a-random-string
APP_HOST=0.0.0.0
APP_PORT=8000
